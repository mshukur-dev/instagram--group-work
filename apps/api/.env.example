# Copy to .env and fill in. Never commit .env.

# Database (local Docker: pnpm db:up)
DATABASE_URL=postgresql://instagram:instagram@localhost:5433/instagram

# Server
PORT=4000
WEB_URL=http://localhost:3000
NODE_ENV=development

# JWT secrets — any long random strings, different from each other
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_SOCKET_SECRET=

# Google OAuth (https://console.cloud.google.com → APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Cloudinary (https://console.cloudinary.com → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LiveKit (local Docker dev server uses devkey / secret)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Web Push (generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:team@example.com

# Demo accounts act on their own (likes, comments, follows, replies): true / false
DEMO_BOTS=false
